<?xml version="1.0"?>
<ruleset name="Kadence Child FLACSO">
    <description>Reglas de calidad y seguridad para el tema hijo de FLACSO Uruguay.</description>

    <file>./</file>
    <exclude-pattern>vendor/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>
    <arg value="sp"/>

    <rule ref="WordPress"/>
    <rule ref="WordPress-Extra"/>
    <rule ref="WordPress-Docs"/>

    <config name="minimum_supported_wp_version" value="6.2"/>
    <config name="text_domain" value="kadence-child-flacso,flacso-uruguay"/>
</ruleset>
